package com.example.data.security
import android.content.Context
import android.security.keystore.KeyGenParameterSpec
import android.security.keystore.KeyProperties
import android.util.Base64
import org.json.JSONArray
import org.json.JSONObject
import java.security.KeyStore
import javax.crypto.Cipher
import javax.crypto.KeyGenerator
import javax.crypto.SecretKey
import javax.crypto.spec.GCMParameterSpec

/** Bearer token and server-issued store grants are encrypted together with Android Keystore AES-GCM. */
interface BearerSessionTokenProvider {
    fun read(): String?
    fun readStoreIds(): Set<String> = emptySet()
}
class EncryptedSessionTokenStore(context: Context) : BearerSessionTokenProvider {
    private val preferences = context.getSharedPreferences("faneva_v2_auth_session", Context.MODE_PRIVATE)

    @Synchronized
    fun save(token: String, expiresAt: Long, storeIds: Collection<String> = emptyList()) {
        require(token.matches(Regex("[A-Za-z0-9_-]{43}"))) { "SESSION_TOKEN_INVALID" }
        val grants = storeIds.toSet()
        require(grants.all { it in VALID_STORES }) { "SESSION_STORE_SCOPE_INVALID" }
        val payload = JSONObject().put("token", token).put("storeIds", JSONArray(grants.sorted())).toString()
        val cipher = Cipher.getInstance(TRANSFORMATION)
        cipher.init(Cipher.ENCRYPT_MODE, getOrCreateKey())
        val encrypted = cipher.doFinal(payload.toByteArray(Charsets.UTF_8))
        preferences.edit().putString(KEY_CIPHERTEXT, Base64.encodeToString(encrypted, Base64.NO_WRAP))
            .putString(KEY_IV, Base64.encodeToString(cipher.iv, Base64.NO_WRAP))
            .putLong(KEY_EXPIRY, expiresAt).apply()
    }

    @Synchronized
    fun updateStoreIds(storeIds: Collection<String>) {
        val token = read() ?: throw IllegalStateException("SESSION_TOKEN_MISSING")
        save(token, preferences.getLong(KEY_EXPIRY, 0L), storeIds)
    }

    @Synchronized
    override fun read(): String? = decodePayload()?.first

    @Synchronized
    override fun readStoreIds(): Set<String> = decodePayload()?.second ?: emptySet()

    @Synchronized
    fun clear() { preferences.edit().clear().apply() }

    /** Legacy token-only ciphertext stays readable, but grants no stores until server validation refreshes it. */
    private fun decodePayload(): Pair<String, Set<String>>? {
        val expiry = preferences.getLong(KEY_EXPIRY, 0L)
        val encoded = preferences.getString(KEY_CIPHERTEXT, null) ?: return null
        val ivText = preferences.getString(KEY_IV, null) ?: return clearAndReturnNull()
        if (expiry <= System.currentTimeMillis() / 1000L) return clearAndReturnNull()
        return try {
            val cipher = Cipher.getInstance(TRANSFORMATION)
            cipher.init(Cipher.DECRYPT_MODE, getOrCreateKey(), GCMParameterSpec(128, Base64.decode(ivText, Base64.NO_WRAP)))
            val plain = String(cipher.doFinal(Base64.decode(encoded, Base64.NO_WRAP)), Charsets.UTF_8)
            if (plain.matches(Regex("[A-Za-z0-9_-]{43}"))) plain to emptySet()
            else {
                val json = JSONObject(plain)
                val token = json.getString("token")
                require(token.matches(Regex("[A-Za-z0-9_-]{43}")))
                val a = json.optJSONArray("storeIds") ?: JSONArray()
                val grants = (0 until a.length()).map { a.getString(it) }.toSet()
                require(grants.all { it in VALID_STORES })
                token to grants
            }
        } catch (_: Exception) { clearAndReturnNull() }
    }

    private fun clearAndReturnNull(): Pair<String, Set<String>>? { clear(); return null }
    private fun getOrCreateKey(): SecretKey {
        val ks = KeyStore.getInstance(ANDROID_KEY_STORE).apply { load(null) }
        (ks.getKey(KEY_ALIAS, null) as? SecretKey)?.let { return it }
        val generator = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, ANDROID_KEY_STORE)
        generator.init(KeyGenParameterSpec.Builder(KEY_ALIAS,
            KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT)
            .setBlockModes(KeyProperties.BLOCK_MODE_GCM).setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
            .setRandomizedEncryptionRequired(true).setKeySize(256).build())
        return generator.generateKey()
    }
    companion object {
        private val VALID_STORES = setOf("A1", "A2", "A3", "A4", "A5")
        private const val ANDROID_KEY_STORE = "AndroidKeyStore"
        private const val KEY_ALIAS = "faneva_v2_session_aes_gcm_v1"
        private const val TRANSFORMATION = "AES/GCM/NoPadding"
        private const val KEY_CIPHERTEXT = "token_ciphertext"
        private const val KEY_IV = "token_iv"
        private const val KEY_EXPIRY = "expires_at"
    }
}
